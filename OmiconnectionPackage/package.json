{
  "name": "@omiai/omi-react-native",
  "version": "1.0.0",
  "description": "React Native SDK for discovering, connecting to, and streaming audio from Omi devices.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "scripts": {
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build": "bob build"
  },
  "keywords": ["react-native", "bluetooth", "ble", "omi"],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70",
    "react-native-ble-plx": "^3.4.2"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@react-native/babel-preset": "^0.79.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.10",
    "jest": "^29.7.0",
    "react": "^19.0.0",
    "react-native": "^0.79.2",
    "react-native-builder-bob": "^0.20.0",
    "typescript": "^5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": ["commonjs", "module", ["typescript", { "project": "tsconfig.build.json" }]]
  },
  "jest": {
    "preset": "react-native",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^react-native-ble-plx$": "<rootDir>/tests/blePlxMock.ts"
    }
  }
}
