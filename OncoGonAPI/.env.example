ENVIRONMENT=development          # "production" hides /docs and never returns reset codes
GATEWAY_PORT=8000
CORS_ORIGINS=*

# Must match OncoGonDB/.env
POSTGRES_DB=oncogon
AUTH_DB_USER=oncogon_auth
AUTH_DB_PASSWORD=change-me-auth

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-hex-string-change-me-to-a-64-char
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=20

# Voice backend (oncogon-tts-sst) behind /api/v1/voice/*. Default: its Docker container on oncogon-net.
# VOICE_SERVICE_URL=http://host.docker.internal:8010   # when running it natively instead

# Research data: OncoGonResearchAPI (PostgreSQL, read + write) when running; else the mock service.
# RESEARCH_SERVICE_URL=http://oncogon-research-api:8002
