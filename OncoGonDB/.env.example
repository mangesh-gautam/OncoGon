# Superuser for the container (used only for administration and init scripts).
POSTGRES_USER=oncogon_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=oncogon
POSTGRES_HOST_PORT=5433

# Least-privilege role used by the auth microservice (created by init/01-init.sh).
AUTH_DB_USER=oncogon_auth
AUTH_DB_PASSWORD=change-me-auth

# Least-privilege role used by the research service (created by init/02-research.sh).
RESEARCH_DB_USER=oncogon_research
RESEARCH_DB_PASSWORD=change-me-research
